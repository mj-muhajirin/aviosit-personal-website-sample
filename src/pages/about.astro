---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About — AviosIT"
  description="Learn more about AviosIT, a personal website focused on web development, programming, AI, and technical learning."
>
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h1 class="section-header__title">
          About AviosIT
        </h1>

        <p class="section-header__description">
          A personal website for sharing projects, programming knowledge,
          technical tutorials, and learning resources.
        </p>
      </div>

      <div class="content">
        <p>
          AviosIT is a personal platform focused on software development,
          modern web technologies, artificial intelligence, and technical
          education.
        </p>

        <p>
          This website is built with Astro and TypeScript, with a focus on
          performance, accessibility, maintainability, and scalable content
          architecture.
        </p>

        <p>
          The platform will continue to grow with new projects, programming
          tutorials, and learning resources.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>