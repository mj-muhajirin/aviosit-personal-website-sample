{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aviosit-personal-website-sample",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
